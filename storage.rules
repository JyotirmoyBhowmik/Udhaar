rules_version = '2';

// Firebase Storage Security Rules for Udhaar Payment Proofs
// Direct client uploads are disabled.
// All proof uploads happen exclusively via Cloud Functions v4 signed URLs
// (with contentType and x-goog-content-length-range: 0,5242880) or the Admin SDK.
service firebase.storage {
  match /b/{bucket}/o {
    match /payment_proofs/{recordId}/{fileName} {
      // Clients cannot upload directly; uploads must use Admin SDK or signed URLs
      allow create: if false;

      // Signed download URLs or authenticated participants may read proof metadata/files
      allow read: if request.auth != null;

      // Never allow client-side overwrite or deletion of an uploaded payment receipt
      allow update, delete: if false;
    }

    match /guest_proofs/{recordId}/{fileName} {
      // Clients cannot upload directly; uploads must use Admin SDK or signed URLs
      allow create: if false;

      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
