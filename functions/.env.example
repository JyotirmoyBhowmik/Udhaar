# =============================================================================
# Udhaar Cloud Functions Environment Configuration (functions/.env.example)
# Copy this file to functions/.env in Cloud Shell before running:
#   firebase deploy --only functions,hosting --project gen-lang-client-0216629575
# =============================================================================

# 1. Brevo Transactional Email API (for /api/sendEmailOtp & Platform v2 Email OTP)
BREVO_API_KEY=
EMAIL_PROVIDER=brevo
EMAIL_FROM_ADDRESS=Udhaar <no-reply@jyotirmoyb.com>

# 2. Meta WhatsApp Cloud API (for WhatsApp OTP & template messages)
META_WHATSAPP_TOKEN=
WHATSAPP_API_TOKEN=
META_PHONE_NUMBER_ID=1398055963399871
META_API_VERSION=v21.0
META_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
