{
  "name": "udhaar-web",
  "version": "32.0.0",
  "description": "Udhaar — Keep clear records of money you lend and borrow. Web landing, Trust Center, and Guest Confirmation Portal.",
  "private": true,
  "scripts": {
    "build": "node scripts/build-web.js && node scripts/build-webapp.js",
    "build:webapp": "node scripts/build-webapp.js",
    "optimize:images": "node scripts/optimize-images.js",
    "test": "node scripts/verify-launch-checklist.js && node scripts/check-no-maps.js && node scripts/check-public-assets.js && node scripts/test-action-schema.js && node --test web-tests/*.test.js",
    "test:rules": "node --test rules-tests/firestore-rules.test.js",
    "test:web": "node scripts/test-action-schema.js && node --test web-tests/*.test.js",
    "test:conformance": "node sync-conformance/ts-runner.js",
    "test:e2e": "node --test web-tests/playwright_e2e.test.js",
    "check:types": "tsc -p webapp/tsconfig.json",
    "check:checklist": "node scripts/verify-launch-checklist.js",
    "check:nomaps": "node scripts/check-no-maps.js",
    "check:assets": "node scripts/check-public-assets.js",
    "check:i18n": "node archive/blaze_disabled/functions/check_i18n.js",
    "lint": "eslint web/*.js web/u/*.js",
    "lint:css": "stylelint web/*.css"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "eslint": "^9.0.0",
    "stylelint": "^18.1.0",
    "typescript": "^7.0.2"
  }
}
