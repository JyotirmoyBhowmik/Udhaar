{
  "name": "udhaar-web",
  "version": "21.0.0",
  "description": "Udhaar — Keep clear records of money you lend and borrow. Web landing, Trust Center, and Guest Confirmation Portal.",
  "private": true,
  "scripts": {
    "build": "node scripts/build-web.js && node scripts/build-webapp.js",
    "build:webapp": "node scripts/build-webapp.js",
    "optimize:images": "node scripts/optimize-images.js",
    "test": "npm --prefix functions test",
    "test:unit": "npm --prefix functions test",
    "test:e2e": "node functions/test/playwright_e2e.test.js",
    "check:i18n": "node functions/check_i18n.js",
    "lint": "eslint web/*.js web/u/*.js",
    "lint:css": "stylelint web/*.css"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "stylelint": "^16.0.0"
  }
}
