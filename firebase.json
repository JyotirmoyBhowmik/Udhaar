{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md"
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "**/*.@(woff2|woff|ttf|webp|svg|png|jpg|jpeg|gif|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "/u/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), microphone=(), camera=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; base-uri 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://*.cloudfunctions.net https://asia-south1-*.cloudfunctions.net https://*.firebaseio.com; frame-ancestors 'none';"
          }
        ]
      },
      {
        "source": "/ledger/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), microphone=(), camera=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; base-uri 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://*.cloudfunctions.net https://asia-south1-*.cloudfunctions.net https://*.firebaseio.com; frame-ancestors 'none';"
          }
        ]
      },
      {
        "source": "/api/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "**/*.@(html|htm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), microphone=(), camera=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; base-uri 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://*.cloudfunctions.net https://asia-south1-*.cloudfunctions.net https://*.firebaseio.com; frame-ancestors 'none';"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), microphone=(), camera=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; base-uri 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://*.cloudfunctions.net https://asia-south1-*.cloudfunctions.net https://*.firebaseio.com; frame-ancestors 'none';"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/guide",
        "destination": "/guide/index.html"
      },
      {
        "source": "/guide/**",
        "destination": "/guide/index.html"
      },
      {
        "source": "/u/**/guest.css",
        "destination": "/u/guest.css"
      },
      {
        "source": "/u/**/guest.js",
        "destination": "/u/guest.js"
      },
      {
        "source": "/u/**/qrcode.min.js",
        "destination": "/assets/qrcode.min.js"
      },
      {
        "source": "/u/**/icon.svg",
        "destination": "/assets/icon.svg"
      },
      {
        "source": "/u/**/icon.webp",
        "destination": "/assets/icon.webp"
      },
      {
        "source": "/u/r/**",
        "destination": "/u/index.html"
      },
      {
        "source": "/u/**",
        "destination": "/u/index.html"
      },
      {
        "source": "/api/getGuestRecord",
        "function": {
          "functionId": "getGuestRecord",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/guestConfirm",
        "function": {
          "functionId": "guestConfirm",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/guestDispute",
        "function": {
          "functionId": "guestDispute",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/guestPaymentClaim",
        "function": {
          "functionId": "guestPaymentClaim",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/guestProposeDate",
        "function": {
          "functionId": "guestProposeDate",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/guestSetUpi",
        "function": {
          "functionId": "guestSetUpi",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/verifyGuestPhoneOtp",
        "function": {
          "functionId": "verifyGuestPhoneOtp",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/renewGuestCode",
        "function": {
          "functionId": "renewGuestCode",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/syncWebRecord",
        "function": {
          "functionId": "syncWebRecord",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/getUserLedger",
        "function": {
          "functionId": "getUserLedger",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/verifyEmailOtp",
        "function": {
          "functionId": "verifyEmailOtp",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/sendEmailOtp",
        "function": {
          "functionId": "sendEmailOtp",
          "region": "asia-south1"
        }
      },
      {
        "source": "/ledger/**",
        "destination": "/ledger/index.html"
      },
      {
        "source": "/ledger",
        "destination": "/ledger/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
