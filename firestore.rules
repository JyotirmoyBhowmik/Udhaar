rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Authentication & Ownership Helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedSignedIn() {
      return isSignedIn()
        && request.auth.token.email_verified == true;
    }

    function isVerifiedOwner(uid) {
      return isVerifiedSignedIn()
        && request.auth.uid == uid;
    }

    function isUserBlockedBy(ownerUid, candidateUid) {
      return ownerUid is string
        && ownerUid.size() >= 1
        && candidateUid is string
        && candidateUid.size() >= 1
        && exists(/databases/$(database)/documents/users/$(ownerUid)/blocked_users/$(candidateUid))
        && get(/databases/$(database)/documents/users/$(ownerUid)/blocked_users/$(candidateUid)).data.isBlocked == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidParticipantsList(listVal) {
      return listVal is list &&
             listVal.size() >= 1 &&
             listVal.size() <= 2 &&
             listVal[0] is string &&
             listVal[0].size() >= 1 &&
             listVal[0].size() <= 128 &&
             (listVal.size() == 1 || (listVal[1] is string && listVal[1].size() >= 1 && listVal[1].size() <= 128));
    }

    function isValidOptionalUidList(listVal) {
      return listVal is list &&
             listVal.size() >= 0 &&
             listVal.size() <= 2 &&
             (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() >= 1 && listVal[0].size() <= 128)) &&
             (listVal.size() <= 1 || (listVal[1] is string && listVal[1].size() >= 1 && listVal[1].size() <= 128));
    }

    // -------------------------------------------------------------------------
    // Strict Size, Type, Length & Monotonic Revision Helpers
    // -------------------------------------------------------------------------
    function strBytes(d, k) {
      return (k in d && d[k] is string) ? d[k].toUtf8().size() : 0;
    }

    // Enforces real UTF-8 byte budget (estimatedBytes <= maxBytes) + strict key cap.
    // Every collection allow-lists keys via keys().hasOnly(...) and sums strBytes(...)
    // for all allowed string fields plus 16 bytes per key/scalar overhead.
    function withinSize(estimatedBytes, maxBytes) {
      return maxBytes > 0
        && estimatedBytes >= 0
        && estimatedBytes <= maxBytes
        && request.resource.data.keys().size() <= 40;
    }

    function reqStr(d, k, minBytes, maxBytes) {
      return (k in d)
        && d[k] is string
        && d[k].toUtf8().size() >= minBytes
        && d[k].toUtf8().size() <= maxBytes;
    }

    function optStr(d, k, maxBytes) {
      return !(k in d)
        || (d[k] is string && d[k].toUtf8().size() <= maxBytes);
    }

    function optInt(d, k, minVal, maxVal) {
      return !(k in d)
        || (d[k] is int && d[k] >= minVal && d[k] <= maxVal);
    }

    function optNullableInt(d, k, minVal, maxVal) {
      return !(k in d)
        || d[k] == null
        || (d[k] is int && d[k] >= minVal && d[k] <= maxVal);
    }

    function optBool(d, k) {
      return !(k in d) || d[k] is bool;
    }

    function validRevOnCreate(d) {
      return ('rev' in d) && d.rev is int && d.rev == 1;
    }

    function validRevOnUpdate(d) {
      return ('rev' in d)
        && d.rev is int
        && ('rev' in resource.data)
        && resource.data.rev is int
        && d.rev == resource.data.rev + 1;
    }

    // -------------------------------------------------------------------------
    // Collection Schema Validators (Allow-List + Types + Lengths + Byte Budget)
    // -------------------------------------------------------------------------
    function validUser(uid) {
      let d = request.resource.data;
      let estBytes = d.keys().size() * 16
        + strBytes(d, 'uid')
        + strBytes(d, 'ownerUid')
        + strBytes(d, 'email')
        + strBytes(d, 'displayName')
        + strBytes(d, 'photoUrl')
        + strBytes(d, 'phoneNumber')
        + strBytes(d, 'contactPhone')
        + strBytes(d, 'preferredLocale')
        + strBytes(d, 'currency')
        + strBytes(d, 'defaultCurrency')
        + strBytes(d, 'deviceId');
      return d.keys().hasOnly([
          'uid', 'ownerUid', 'email', 'displayName', 'photoUrl',
          'phoneNumber', 'contactPhone', 'phoneVerified', 'preferredLocale',
          'currency', 'defaultCurrency', 'deviceId', 'rev',
          'createdAtMs', 'updatedAtMs', 'cloudSyncEnabled', 'schemaVersion'
        ])
        && d.ownerUid == uid
        && (!('uid' in d) || d.uid == uid)
        && optStr(d, 'email', 254)
        && optStr(d, 'displayName', 512)
        && optStr(d, 'photoUrl', 1024)
        && optStr(d, 'phoneNumber', 32)
        && optStr(d, 'contactPhone', 32)
        && (!('phoneVerified' in d) || d.phoneVerified == false)
        && optStr(d, 'preferredLocale', 16)
        && (!('currency' in d) || d.currency in ['INR', 'NPR'])
        && (!('defaultCurrency' in d) || d.defaultCurrency in ['INR', 'NPR'])
        && optStr(d, 'deviceId', 128)
        && optBool(d, 'cloudSyncEnabled')
        && optInt(d, 'schemaVersion', 1, 10)
        && optInt(d, 'createdAtMs', 1, 4102444800000)
        && ('updatedAtMs' in d) && d.updatedAtMs is int && d.updatedAtMs > 0 && d.updatedAtMs <= 4102444800000
        && withinSize(estBytes, 1536);
    }

    function validRecord(uid) {
      let d = request.resource.data;
      let estBytes = d.keys().size() * 16
        + strBytes(d, 'id')
        + strBytes(d, 'recordId')
        + strBytes(d, 'syncId')
        + strBytes(d, 'ownerUid')
        + strBytes(d, 'uid')
        + strBytes(d, 'partyId')
        + strBytes(d, 'partyName')
        + strBytes(d, 'phoneNumber')
        + strBytes(d, 'currency')
        + strBytes(d, 'direction')
        + strBytes(d, 'transactionType')
        + strBytes(d, 'status')
        + strBytes(d, 'note')
        + strBytes(d, 'notes')
        + strBytes(d, 'hlc')
        + strBytes(d, 'deviceId');
      return d.keys().hasOnly([
          'id', 'recordId', 'syncId', 'ownerUid', 'uid', 'partyId', 'partyName',
          'phoneNumber', 'principalAmountPaise', 'amountPaise', 'amountPaidPaise',
          'remainingAmountPaise', 'interestAmountPaise', 'currency', 'direction',
          'transactionType', 'status', 'note', 'notes', 'dueDateMs', 'startDateMs',
          'settledAtMs', 'deletedAtMs', 'isSettled', 'isDeleted', 'deleted',
          'hlc', 'deviceId', 'rev', 'clientRev', 'createdAtMs', 'updatedAtMs',
          'schemaVersion'
        ])
        && d.ownerUid == uid
        && (!('uid' in d) || d.uid == uid)
        && optStr(d, 'id', 128)
        && optStr(d, 'recordId', 128)
        && optStr(d, 'syncId', 128)
        && optStr(d, 'partyId', 128)
        && optStr(d, 'partyName', 200)
        && optStr(d, 'phoneNumber', 32)
        && optInt(d, 'principalAmountPaise', 0, 100000000000)
        && optInt(d, 'amountPaise', 0, 100000000000)
        && optInt(d, 'amountPaidPaise', 0, 100000000000)
        && optInt(d, 'remainingAmountPaise', 0, 100000000000)
        && optInt(d, 'interestAmountPaise', 0, 100000000000)
        && (!('currency' in d) || d.currency in ['INR', 'NPR'])
        && (!('direction' in d) || d.direction in ['GIVEN', 'TAKEN'])
        && (!('transactionType' in d) || d.transactionType in ['GIVEN', 'TAKEN'])
        && (!('status' in d) || d.status in ['PENDING', 'ACTIVE', 'PARTIALLY_PAID', 'SETTLED', 'DISPUTED', 'OVERDUE', 'DELETED'])
        && optStr(d, 'note', 1000)
        && optStr(d, 'notes', 1000)
        && optNullableInt(d, 'dueDateMs', 0, 4102444800000)
        && optNullableInt(d, 'startDateMs', 0, 4102444800000)
        && optNullableInt(d, 'settledAtMs', 0, 4102444800000)
        && optNullableInt(d, 'deletedAtMs', 0, 4102444800000)
        && optBool(d, 'isSettled')
        && optBool(d, 'isDeleted')
        && optBool(d, 'deleted')
        && optStr(d, 'hlc', 128)
        && optStr(d, 'deviceId', 128)
        && optInt(d, 'clientRev', 0, 1000000000)
        && optInt(d, 'schemaVersion', 1, 10)
        && optInt(d, 'createdAtMs', 1, 4102444800000)
        && ('updatedAtMs' in d) && d.updatedAtMs is int && d.updatedAtMs > 0 && d.updatedAtMs <= 4102444800000
        && withinSize(estBytes, 2048);
    }

    function validPerson(uid) {
      let d = request.resource.data;
      let estBytes = d.keys().size() * 16
        + strBytes(d, 'id')
        + strBytes(d, 'personId')
        + strBytes(d, 'syncId')
        + strBytes(d, 'ownerUid')
        + strBytes(d, 'uid')
        + strBytes(d, 'name')
        + strBytes(d, 'displayName')
        + strBytes(d, 'phoneNumber')
        + strBytes(d, 'contactPhone')
        + strBytes(d, 'email')
        + strBytes(d, 'upiId')
        + strBytes(d, 'note')
        + strBytes(d, 'notes')
        + strBytes(d, 'hlc')
        + strBytes(d, 'deviceId');
      return d.keys().hasOnly([
          'id', 'personId', 'syncId', 'ownerUid', 'uid', 'name', 'displayName',
          'phoneNumber', 'contactPhone', 'email', 'upiId', 'note', 'notes',
          'isArchived', 'isDeleted', 'deletedAtMs', 'hlc', 'deviceId',
          'rev', 'clientRev', 'createdAtMs', 'updatedAtMs', 'schemaVersion'
        ])
        && d.ownerUid == uid
        && (!('uid' in d) || d.uid == uid)
        && optStr(d, 'id', 128)
        && optStr(d, 'personId', 128)
        && optStr(d, 'syncId', 128)
        && reqStr(d, 'name', 1, 120)
        && optStr(d, 'displayName', 120)
        && optStr(d, 'phoneNumber', 32)
        && optStr(d, 'contactPhone', 32)
        && optStr(d, 'email', 254)
        && optStr(d, 'upiId', 128)
        && optStr(d, 'note', 500)
        && optStr(d, 'notes', 500)
        && optBool(d, 'isArchived')
        && optBool(d, 'isDeleted')
        && optNullableInt(d, 'deletedAtMs', 0, 4102444800000)
        && optStr(d, 'hlc', 128)
        && optStr(d, 'deviceId', 128)
        && optInt(d, 'clientRev', 0, 1000000000)
        && optInt(d, 'schemaVersion', 1, 10)
        && optInt(d, 'createdAtMs', 1, 4102444800000)
        && ('updatedAtMs' in d) && d.updatedAtMs is int && d.updatedAtMs > 0 && d.updatedAtMs <= 4102444800000
        && withinSize(estBytes, 1536);
    }

    function validEvent(uid) {
      let d = request.resource.data;
      let estBytes = d.keys().size() * 16
        + strBytes(d, 'id')
        + strBytes(d, 'eventId')
        + strBytes(d, 'paymentId')
        + strBytes(d, 'syncId')
        + strBytes(d, 'ownerUid')
        + strBytes(d, 'uid')
        + strBytes(d, 'recordId')
        + strBytes(d, 'recordSyncId')
        + strBytes(d, 'eventType')
        + strBytes(d, 'paymentMode')
        + strBytes(d, 'referenceNumber')
        + strBytes(d, 'note')
        + strBytes(d, 'notes')
        + strBytes(d, 'hlc')
        + strBytes(d, 'deviceId');
      return d.keys().hasOnly([
          'id', 'eventId', 'paymentId', 'syncId', 'ownerUid', 'uid',
          'recordId', 'recordSyncId', 'eventType', 'amountPaise', 'paymentMode',
          'referenceNumber', 'note', 'notes', 'timestampMs', 'createdAtMs',
          'hlc', 'deviceId', 'rev', 'schemaVersion'
        ])
        && d.ownerUid == uid
        && (!('uid' in d) || d.uid == uid)
        && optStr(d, 'id', 128)
        && optStr(d, 'eventId', 128)
        && optStr(d, 'paymentId', 128)
        && optStr(d, 'syncId', 128)
        && optStr(d, 'recordId', 128)
        && optStr(d, 'recordSyncId', 128)
        && ('eventType' in d) && d.eventType in [
          'PAYMENT', 'CONFIRM', 'DISPUTE', 'PROPOSE_DATE',
          'NOTE', 'SETTLEMENT', 'ADJUSTMENT', 'LINK_CREATED', 'LINK_REVOKED'
        ]
        && optInt(d, 'amountPaise', 0, 100000000000)
        && (!('paymentMode' in d) || d.paymentMode in ['UPI', 'CASH', 'BANK_TRANSFER', 'CHEQUE', 'OTHER'])
        && optStr(d, 'referenceNumber', 64)
        && optStr(d, 'note', 500)
        && optStr(d, 'notes', 500)
        && optInt(d, 'timestampMs', 1, 4102444800000)
        && ('createdAtMs' in d) && d.createdAtMs is int && d.createdAtMs > 0 && d.createdAtMs <= 4102444800000
        && optStr(d, 'hlc', 128)
        && optStr(d, 'deviceId', 128)
        && (!('rev' in d) || (d.rev is int && d.rev == 1))
        && optInt(d, 'schemaVersion', 1, 10)
        && withinSize(estBytes, 1536);
    }

    function validPlan(uid) {
      let d = request.resource.data;
      let estBytes = d.keys().size() * 16
        + strBytes(d, 'id')
        + strBytes(d, 'planId')
        + strBytes(d, 'syncId')
        + strBytes(d, 'ownerUid')
        + strBytes(d, 'uid')
        + strBytes(d, 'recordId')
        + strBytes(d, 'recordSyncId')
        + strBytes(d, 'frequency')
        + strBytes(d, 'status')
        + strBytes(d, 'note')
        + strBytes(d, 'notes')
        + strBytes(d, 'hlc')
        + strBytes(d, 'deviceId');
      return d.keys().hasOnly([
          'id', 'planId', 'syncId', 'ownerUid', 'uid', 'recordId', 'recordSyncId',
          'frequency', 'installmentCount', 'installmentAmountPaise', 'totalAmountPaise',
          'startDateMs', 'nextDueDateMs', 'status', 'note', 'notes',
          'isDeleted', 'deletedAtMs', 'hlc', 'deviceId', 'rev',
          'createdAtMs', 'updatedAtMs', 'schemaVersion'
        ])
        && d.ownerUid == uid
        && (!('uid' in d) || d.uid == uid)
        && optStr(d, 'id', 128)
        && optStr(d, 'planId', 128)
        && optStr(d, 'syncId', 128)
        && optStr(d, 'recordId', 128)
        && optStr(d, 'recordSyncId', 128)
        && ('frequency' in d) && d.frequency in ['DAILY', 'WEEKLY', 'BIWEEKLY', 'MONTHLY', 'QUARTERLY', 'CUSTOM']
        && optInt(d, 'installmentCount', 1, 360)
        && optInt(d, 'installmentAmountPaise', 0, 100000000000)
        && optInt(d, 'totalAmountPaise', 0, 100000000000)
        && optNullableInt(d, 'startDateMs', 0, 4102444800000)
        && optNullableInt(d, 'nextDueDateMs', 0, 4102444800000)
        && (!('status' in d) || d.status in ['ACTIVE', 'PAUSED', 'COMPLETED', 'CANCELLED'])
        && optStr(d, 'note', 500)
        && optStr(d, 'notes', 500)
        && optBool(d, 'isDeleted')
        && optNullableInt(d, 'deletedAtMs', 0, 4102444800000)
        && optStr(d, 'hlc', 128)
        && optStr(d, 'deviceId', 128)
        && optInt(d, 'schemaVersion', 1, 10)
        && optInt(d, 'createdAtMs', 1, 4102444800000)
        && ('updatedAtMs' in d) && d.updatedAtMs is int && d.updatedAtMs > 0 && d.updatedAtMs <= 4102444800000
        && withinSize(estBytes, 1536);
    }

    function validAttachment(uid) {
      let d = request.resource.data;
      let estBytes = d.keys().size() * 16
        + strBytes(d, 'id')
        + strBytes(d, 'attachmentId')
        + strBytes(d, 'syncId')
        + strBytes(d, 'ownerUid')
        + strBytes(d, 'uid')
        + strBytes(d, 'recordId')
        + strBytes(d, 'recordSyncId')
        + strBytes(d, 'filename')
        + strBytes(d, 'mimeType')
        + strBytes(d, 'sha256')
        + strBytes(d, 'storageRef')
        + strBytes(d, 'localPath')
        + strBytes(d, 'note');
      return d.keys().hasOnly([
          'id', 'attachmentId', 'syncId', 'ownerUid', 'uid', 'recordId', 'recordSyncId',
          'filename', 'mimeType', 'sizeBytes', 'sha256', 'storageRef', 'localPath',
          'note', 'isDeleted', 'deletedAtMs', 'rev', 'createdAtMs', 'updatedAtMs',
          'schemaVersion'
        ])
        && d.ownerUid == uid
        && (!('uid' in d) || d.uid == uid)
        && optStr(d, 'id', 128)
        && optStr(d, 'attachmentId', 128)
        && optStr(d, 'syncId', 128)
        && optStr(d, 'recordId', 128)
        && optStr(d, 'recordSyncId', 128)
        && reqStr(d, 'filename', 1, 255)
        && ('mimeType' in d) && d.mimeType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf']
        && ('sizeBytes' in d) && d.sizeBytes is int && d.sizeBytes >= 0 && d.sizeBytes <= 10485760
        && optStr(d, 'sha256', 64)
        && optStr(d, 'storageRef', 256)
        && optStr(d, 'localPath', 256)
        && optStr(d, 'note', 500)
        && optBool(d, 'isDeleted')
        && optNullableInt(d, 'deletedAtMs', 0, 4102444800000)
        && optInt(d, 'schemaVersion', 1, 10)
        && optInt(d, 'createdAtMs', 1, 4102444800000)
        && ('updatedAtMs' in d) && d.updatedAtMs is int && d.updatedAtMs > 0 && d.updatedAtMs <= 4102444800000
        && withinSize(estBytes, 1536);
    }

    function validSyncSignal(uid) {
      let d = request.resource.data;
      let estBytes = d.keys().size() * 16
        + strBytes(d, 'ownerUid')
        + strBytes(d, 'deviceId');
      return d.keys().hasOnly(['ownerUid', 'updatedAtMs', 'lastSyncAtMs', 'deviceId', 'rev'])
        && d.ownerUid == uid
        && ('updatedAtMs' in d) && d.updatedAtMs is int && d.updatedAtMs > 0 && d.updatedAtMs <= 4102444800000
        && optInt(d, 'lastSyncAtMs', 1, 4102444800000)
        && optStr(d, 'deviceId', 128)
        && withinSize(estBytes, 512);
    }

    function validBlockedUser(targetUid) {
      let d = request.resource.data;
      let estBytes = d.keys().size() * 16
        + strBytes(d, 'targetUid')
        + strBytes(d, 'reportReason');
      return d.keys().hasOnly([
          'targetUid', 'isMuted', 'isBlocked', 'isReported', 'reportReason', 'updatedAt'
        ])
        && d.targetUid is string
        && d.targetUid == targetUid
        && isValidId(targetUid)
        && d.isMuted is bool
        && d.isBlocked is bool
        && d.isReported is bool
        && d.reportReason is string
        && d.reportReason.toUtf8().size() <= 300
        && d.updatedAt is timestamp
        && d.updatedAt <= request.time
        && withinSize(estBytes, 512);
    }

    // -------------------------------------------------------------------------
    // Per-User Spark Collections
    // -------------------------------------------------------------------------
    match /users/{uid} {
      allow read, delete: if isVerifiedOwner(uid);
      allow create: if isVerifiedOwner(uid)
        && validUser(uid)
        && validRevOnCreate(request.resource.data);
      allow update: if isVerifiedOwner(uid)
        && validUser(uid)
        && validRevOnUpdate(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid;

      match /records/{recordId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid)
          && validRecord(uid)
          && validRevOnCreate(request.resource.data);
        allow update: if isVerifiedOwner(uid)
          && validRecord(uid)
          && validRevOnUpdate(request.resource.data)
          && request.resource.data.ownerUid == resource.data.ownerUid;
      }

      match /people/{personId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid)
          && validPerson(uid)
          && validRevOnCreate(request.resource.data);
        allow update: if isVerifiedOwner(uid)
          && validPerson(uid)
          && validRevOnUpdate(request.resource.data)
          && request.resource.data.ownerUid == resource.data.ownerUid;
      }

      match /events/{eventId} {
        allow read: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid) && validEvent(uid);
        allow update, delete: if false; // strictly append-only audit log
      }

      match /plans/{planId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid)
          && validPlan(uid)
          && validRevOnCreate(request.resource.data);
        allow update: if isVerifiedOwner(uid)
          && validPlan(uid)
          && validRevOnUpdate(request.resource.data)
          && request.resource.data.ownerUid == resource.data.ownerUid;
      }

      match /attachments/{attachmentId} {
        allow read, delete: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid)
          && validAttachment(uid)
          && validRevOnCreate(request.resource.data);
        allow update: if isVerifiedOwner(uid)
          && validAttachment(uid)
          && validRevOnUpdate(request.resource.data)
          && request.resource.data.ownerUid == resource.data.ownerUid;
      }

      match /meta/syncSignal {
        allow read, delete: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid)
          && validSyncSignal(uid)
          && validRevOnCreate(request.resource.data);
        allow update: if isVerifiedOwner(uid)
          && validSyncSignal(uid)
          && validRevOnUpdate(request.resource.data)
          && request.resource.data.ownerUid == resource.data.ownerUid;
      }

      match /blocked_users/{targetUid} {
        allow get, delete: if isVerifiedOwner(uid) && isValidId(targetUid);
        allow list: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid)
          && isValidId(targetUid)
          && targetUid != uid
          && validBlockedUser(targetUid);
      }
    }

    // -------------------------------------------------------------------------
    // Guest Capability Links, Actions & Payment Proof (Spark Mode)
    // Every guest path requires a verified email identity.
    // -------------------------------------------------------------------------
    function optNullableStr(d, k, maxBytes) {
      return !(k in d)
        || d[k] == null
        || (d[k] is string && d[k].toUtf8().size() <= maxBytes);
    }

    function validGuestLinkCreate(d, ownerUid) {
      let estBytes = d.keys().size() * 16
        + strBytes(d, 'ownerUid')
        + strBytes(d, 'recordId')
        + strBytes(d, 'status')
        + strBytes(d, 'borrowerDisplayName')
        + strBytes(d, 'lenderDisplayName')
        + strBytes(d, 'lenderUpiId')
        + strBytes(d, 'verificationLevel')
        + strBytes(d, 'expectedGuestEmailHash')
        + strBytes(d, 'counterpartyRole')
        + strBytes(d, 'currency')
        + strBytes(d, 'note');
      return d.keys().hasOnly([
          'schemaVersion', 'ownerUid', 'recordId', 'status',
          'createdAtMs', 'updatedAtMs', 'expiresAtMs', 'revokedAtMs',
          'allowedActions', 'borrowerDisplayName', 'lenderDisplayName',
          'principalPaise', 'paidPaise', 'payableAmountPaise', 'dueDateMs',
          'lenderUpiId', 'verificationLevel', 'expectedGuestEmailHash',
          'allowScreenshotProof', 'counterpartyRole', 'currency', 'note'
        ])
        && d.ownerUid == ownerUid
        && d.schemaVersion is int && d.schemaVersion == 1
        && d.status == 'ACTIVE'
        && reqStr(d, 'recordId', 1, 128)
        && ('payableAmountPaise' in d) && d.payableAmountPaise is int
        && d.payableAmountPaise >= 0 && d.payableAmountPaise <= 100000000000
        && optInt(d, 'principalPaise', 0, 100000000000)
        && optInt(d, 'paidPaise', 0, 100000000000)
        && optNullableInt(d, 'dueDateMs', 0, 4102444800000)
        && optInt(d, 'createdAtMs', 1, 4102444800000)
        && optInt(d, 'updatedAtMs', 1, 4102444800000)
        && ('expiresAtMs' in d) && d.expiresAtMs is int && d.expiresAtMs > 0 && d.expiresAtMs <= 4102444800000
        && optNullableInt(d, 'revokedAtMs', 0, 4102444800000)
        && (!('allowedActions' in d) || (d.allowedActions is list && d.allowedActions.size() <= 4))
        && optNullableStr(d, 'borrowerDisplayName', 120)
        && optNullableStr(d, 'lenderDisplayName', 120)
        && optNullableStr(d, 'lenderUpiId', 128)
        && (!('verificationLevel' in d) || d.verificationLevel in ['PRIVATE_LINK', 'GOOGLE_VERIFIED'])
        && optNullableStr(d, 'expectedGuestEmailHash', 64)
        && optBool(d, 'allowScreenshotProof')
        && (!('counterpartyRole' in d) || d.counterpartyRole in ['BORROWER', 'LENDER'])
        && (!('currency' in d) || d.currency in ['INR', 'NPR'])
        && optNullableStr(d, 'note', 500)
        && !('whatsappOtp' in d)
        && !('otp' in d)
        && withinSize(estBytes, 2048);
    }

    match /guestLinks/{linkId} {
      function isOwner() {
        return isVerifiedSignedIn() && resource.data.ownerUid == request.auth.uid;
      }

      function googleOk(l) {
        return l.verificationLevel != 'GOOGLE_VERIFIED' || (
          request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.token.email_verified == true
          && hashing.sha256(request.auth.token.email.lower()).toHexString().lower() == l.expectedGuestEmailHash);
      }

      allow get: if isVerifiedSignedIn() && isValidId(linkId) && (
          isOwner() || (resource.data.status == 'ACTIVE'
                        && resource.data.expiresAtMs > request.time.toMillis()
                        && googleOk(resource.data)));

      allow list: if isVerifiedSignedIn() && request.query.limit <= 50
                  && resource.data.ownerUid == request.auth.uid;

      allow create: if isVerifiedSignedIn()
        && isValidId(linkId)
        && validGuestLinkCreate(request.resource.data, request.auth.uid);

      allow update: if isVerifiedOwner(resource.data.ownerUid)
        && isValidId(linkId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.recordId == resource.data.recordId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','paidPaise','payableAmountPaise','dueDateMs','updatedAtMs','revokedAtMs','expiresAtMs'])
        && request.resource.data.status in ['ACTIVE', 'REVOKED', 'EXPIRED', 'SETTLED']
        && optInt(request.resource.data, 'paidPaise', 0, 100000000000)
        && optInt(request.resource.data, 'payableAmountPaise', 0, 100000000000)
        && optNullableInt(request.resource.data, 'dueDateMs', 0, 4102444800000)
        && optInt(request.resource.data, 'updatedAtMs', 1, 4102444800000)
        && optNullableInt(request.resource.data, 'revokedAtMs', 0, 4102444800000)
        && optInt(request.resource.data, 'expiresAtMs', 1, 4102444800000);

      allow delete: if isOwner() && isValidId(linkId);

      match /actions/{actionType} {
        function link() { return get(/databases/$(database)/documents/guestLinks/$(linkId)).data; }
        function d() { return request.resource.data; }
        function common() {
          return isVerifiedSignedIn()
            && isValidId(linkId)
            && link().status == 'ACTIVE'
            && link().expiresAtMs > request.time.toMillis()
            && googleOk(link())
            && actionType in link().allowedActions
            && d().schemaVersion == 1
            && d().actionType == actionType
            && d().guestUid == request.auth.uid
            && d().status == 'PENDING'
            && d().createdAtMs is int && d().createdAtMs > 0 && d().createdAtMs <= 4102444800000;
        }

        allow create: if common() && (
          (actionType == 'CONFIRM' && d().keys().hasOnly(['schemaVersion','actionType','guestUid','status','createdAtMs']))
          || (actionType == 'DISPUTE' && d().reason is string && d().reason.size() >= 1 && d().reason.size() <= 500
              && d().keys().hasOnly(['schemaVersion','actionType','guestUid','status','createdAtMs','reason']))
          || (actionType == 'PROPOSE_DATE' && d().proposedDateMs is int
              && d().proposedDateMs > request.time.toMillis()
              && d().proposedDateMs <= 4102444800000
              && (!('reason' in d()) || (d().reason is string && d().reason.size() <= 500))
              && d().keys().hasOnly(['schemaVersion','actionType','guestUid','status','createdAtMs','proposedDateMs','reason']))
          || (actionType == 'CLAIM_PAYMENT' && d().amountPaise is int && d().amountPaise > 0
              && d().amountPaise <= link().payableAmountPaise
              && d().paymentMode in ['UPI','CASH','BANK_TRANSFER']
              && d().referenceNumber is string && d().referenceNumber.size() <= 64
              && (!('note' in d()) || (d().note is string && d().note.size() <= 300))
              && (!('hasProof' in d()) || d().hasProof is bool)
              && d().keys().hasOnly(['schemaVersion','actionType','guestUid','status','createdAtMs',
                                     'amountPaise','paymentMode','referenceNumber','note','hasProof']))
        );

        allow get: if isVerifiedSignedIn()
          && (resource.data.guestUid == request.auth.uid || link().ownerUid == request.auth.uid);

        allow list: if isVerifiedSignedIn() && link().ownerUid == request.auth.uid;

        allow update: if isVerifiedSignedIn() && link().ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAtMs','rejectReason'])
          && request.resource.data.status in ['ACCEPTED','REJECTED']
          && optInt(request.resource.data, 'reviewedAtMs', 1, 4102444800000)
          && optStr(request.resource.data, 'rejectReason', 300);

        allow delete: if isVerifiedSignedIn() && link().ownerUid == request.auth.uid;

        match /proof/{docId} {
          allow create: if isVerifiedSignedIn() && docId == 'image'
            && get(/databases/$(database)/documents/guestLinks/$(linkId)/actions/$(actionType)).data.guestUid == request.auth.uid
            && request.resource.data.keys().hasOnly(['mime', 'dataB64'])
            && request.resource.data.dataB64 is string
            && request.resource.data.dataB64.size() >= 1
            && request.resource.data.dataB64.size() <= 700000
            && request.resource.data.mime in ['image/webp','image/jpeg'];

          allow read: if isVerifiedSignedIn() && (
            get(/databases/$(database)/documents/guestLinks/$(linkId)/actions/$(actionType)).data.guestUid == request.auth.uid
            || link().ownerUid == request.auth.uid);

          allow update: if false;

          allow delete: if isVerifiedSignedIn() && link().ownerUid == request.auth.uid;
        }
      }
    }

    // =========================================================================
    // Real-Time Participant Collections (Spark Mode)
    // 1. /user_profiles/{userId} — Owner profile with UID isolation & PII bounds
    // 2. /shared_records/{remoteId} — Two-party verifiable loan records & subcollections
    // 3. /chat_threads/{threadId} — Phase 4 in-app communication thread
    // =========================================================================

    // -------------------------------------------------------------------------
    // 1. /user_profiles/{userId} — Owner-Isolated Payment & Verification Profile
    // -------------------------------------------------------------------------
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.phoneNumber is string && data.phoneNumber.size() <= 32 &&
             data.upiId is string && data.upiId.size() <= 100 &&
             data.photoUri is string && data.photoUri.size() <= 512 &&
             (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() <= 512)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /user_profiles/{userId} {
      allow get: if isVerifiedSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isVerifiedSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isVerifiedSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'phoneNumber', 'upiId', 'photoUri', 'fcmToken', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isVerifiedSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'phoneNumber', 'upiId', 'photoUri', 'fcmToken', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow delete: if isVerifiedSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // 2. /shared_records/{remoteId} — Two-Party Verifiable Udhaar Record
    //    Readable & writable ONLY by the participants on the record.
    // -------------------------------------------------------------------------
    function isValidSharedRecord(data) {
      return data.remoteId is string && data.remoteId.size() >= 1 && data.remoteId.size() <= 128 &&
             data.creatorUid is string && data.creatorUid.size() >= 1 && data.creatorUid.size() <= 128 &&
             data.counterpartyUid is string && data.counterpartyUid.size() <= 128 &&
             isValidParticipantsList(data.participantUids) &&
             data.creatorUid in data.participantUids &&
             data.lenderName is string && data.lenderName.size() >= 1 && data.lenderName.size() <= 100 &&
             data.borrowerName is string && data.borrowerName.size() >= 1 && data.borrowerName.size() <= 100 &&
             data.creatorRole is string && data.creatorRole in ['GIVEN', 'TAKEN'] &&
             data.currency is string && data.currency in ['INR', 'NPR'] &&
             (data.principalAmount is int || data.principalAmount is float) && data.principalAmount > 0 &&
             (data.amountPaid is int || data.amountPaid is float) && data.amountPaid >= 0 &&
             data.paymentMode is string && data.paymentMode in ['CASH', 'ONLINE', 'UPI', 'PARTY_ACCOUNT', 'BANK_TRANSFER'] &&
             data.isInterestEnabled is bool &&
             data.interestType is string && data.interestType in ['SIMPLE', 'COMPOUND'] &&
             (data.interestRate is int || data.interestRate is float) && data.interestRate >= 0 &&
             data.interestRatePeriod is string && data.interestRatePeriod in ['PER_MONTH', 'PER_ANNUM'] &&
             data.compoundFrequency is string && data.compoundFrequency in ['MONTHLY', 'QUARTERLY', 'YEARLY'] &&
             data.startDateMillis is int && data.startDateMillis >= 0 &&
             data.expiryDateMillis is int && data.expiryDateMillis >= -1 &&
             data.contentHash is string && data.contentHash.size() <= 128 &&
             data.verificationStatus is string && data.verificationStatus in [
               'PENDING', 'CONFIRMED', 'DISPUTED', 'EDITED_AFTER_CONFIRM', 'SETTLED', 'CANCELLED'
             ] &&
             data.verifiedAtMillis is int && data.verifiedAtMillis >= -1 &&
             data.disputeReason is string && data.disputeReason.size() <= 500 &&
             data.encryptedNotes is string && data.encryptedNotes.size() <= 2000 &&
             data.attachmentRefs is list && data.attachmentRefs.size() <= 10 &&
             data.isSettled is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time &&
             optStr(data, 'trustLevel', 50) &&
             optStr(data, 'verifiedPhoneMasked', 32) &&
             optStr(data, 'webLinkStatus', 50) &&
             optStr(data, 'guestUpiId', 100) &&
             optStr(data, 'lastGuestAction', 50) &&
             optBool(data, 'pendingPaymentClaim') &&
             optBool(data, 'pendingDateProposal');
    }

    match /shared_records/{remoteId} {
      allow get: if isVerifiedSignedIn() && isValidId(remoteId) && (resource == null || request.auth.uid in existing().participantUids);
      allow list: if isVerifiedSignedIn() && request.auth.uid in existing().participantUids;

      allow create: if isVerifiedSignedIn() &&
                       isValidId(remoteId) &&
                       incoming().remoteId == remoteId &&
                       incoming().creatorUid == request.auth.uid &&
                       request.auth.uid in incoming().participantUids &&
                       incoming().keys().hasOnly([
                         'remoteId', 'creatorUid', 'counterpartyUid', 'participantUids',
                         'lenderName', 'borrowerName', 'creatorRole', 'currency',
                         'principalAmount', 'amountPaid', 'paymentMode',
                         'isInterestEnabled', 'interestType', 'interestRate',
                         'interestRatePeriod', 'compoundFrequency',
                         'startDateMillis', 'expiryDateMillis', 'contentHash',
                         'verificationStatus', 'verifiedAtMillis', 'disputeReason',
                         'encryptedNotes', 'attachmentRefs', 'isSettled',
                         'createdAt', 'updatedAt',
                         'trustLevel', 'verifiedPhoneMasked', 'webLinkStatus',
                         'guestUpiId', 'lastGuestAction',
                         'pendingPaymentClaim', 'pendingDateProposal'
                       ]) &&
                       isValidSharedRecord(incoming());

      allow update: if isVerifiedSignedIn() &&
                       isValidId(remoteId) &&
                       isValidSharedRecord(incoming()) &&
                       incoming().remoteId == existing().remoteId &&
                       incoming().creatorUid == existing().creatorUid &&
                       incoming().createdAt == existing().createdAt &&
                       // Creator must NOT be able to confirm their own record
                       (
                         incoming().verificationStatus != 'CONFIRMED' ||
                         (
                           request.auth.uid != existing().creatorUid &&
                           (request.auth.uid == existing().counterpartyUid || (existing().counterpartyUid == '' && incoming().counterpartyUid == request.auth.uid))
                         )
                       ) &&
                       // If terms are modified, enforce EDITED_AFTER_CONFIRM status if previously confirmed
                       (
                         !incoming().diff(existing()).affectedKeys().hasAny([
                           'principalAmount', 'currency', 'isInterestEnabled', 'interestRate',
                           'interestType', 'interestRatePeriod', 'compoundFrequency',
                           'startDateMillis', 'expiryDateMillis'
                         ]) ||
                         incoming().verificationStatus == 'EDITED_AFTER_CONFIRM' ||
                         existing().verificationStatus != 'CONFIRMED'
                       ) &&
                       (
                         // Action 1: Counterparty claims an unclaimed record via verification link & confirms/disputes
                         (
                           existing().counterpartyUid == '' &&
                           existing().participantUids.size() == 1 &&
                           request.auth.uid != existing().creatorUid &&
                           incoming().counterpartyUid == request.auth.uid &&
                           incoming().participantUids.size() == 2 &&
                           request.auth.uid in incoming().participantUids &&
                           existing().creatorUid in incoming().participantUids &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'counterpartyUid', 'participantUids', 'verificationStatus',
                             'verifiedAtMillis', 'disputeReason', 'updatedAt',
                             'trustLevel', 'verifiedPhoneMasked', 'webLinkStatus',
                             'guestUpiId', 'lastGuestAction',
                             'pendingPaymentClaim', 'pendingDateProposal'
                           ])
                         ) ||
                         // Action 2: Existing participant updates verification status, terms, extension due date, backup, or settlement
                         (
                           request.auth.uid in existing().participantUids &&
                           incoming().counterpartyUid == existing().counterpartyUid &&
                           incoming().participantUids == existing().participantUids &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'lenderName', 'borrowerName', 'currency',
                             'principalAmount', 'amountPaid', 'paymentMode',
                             'isInterestEnabled', 'interestType', 'interestRate',
                             'interestRatePeriod', 'compoundFrequency',
                             'startDateMillis', 'expiryDateMillis', 'contentHash',
                             'verificationStatus', 'verifiedAtMillis', 'disputeReason',
                             'encryptedNotes', 'attachmentRefs', 'isSettled', 'updatedAt',
                             'trustLevel', 'verifiedPhoneMasked', 'webLinkStatus',
                             'guestUpiId', 'lastGuestAction',
                             'pendingPaymentClaim', 'pendingDateProposal'
                           ])
                         )
                       );

      allow delete: if isVerifiedSignedIn() && isValidId(remoteId) && existing().creatorUid == request.auth.uid;

      // -----------------------------------------------------------------------
      // /shared_records/{remoteId}/partial_payments/{paymentId}
      // -----------------------------------------------------------------------
      function isValidPartialPayment(data) {
        return data.paymentId is string && data.paymentId.size() >= 1 && data.paymentId.size() <= 128 &&
               data.remoteId is string && data.remoteId == remoteId &&
               data.recordedByUid is string && data.recordedByUid.size() >= 1 && data.recordedByUid.size() <= 128 &&
               data.recordedByName is string && data.recordedByName.size() >= 1 && data.recordedByName.size() <= 100 &&
               isValidParticipantsList(data.participantUids) &&
               data.recordedByUid in data.participantUids &&
               (data.amount is int || data.amount is float) && data.amount > 0 &&
               data.paymentMode is string && data.paymentMode in ['CASH', 'ONLINE', 'UPI', 'PARTY_ACCOUNT', 'BANK_TRANSFER'] &&
               data.paidAtMillis is int && data.paidAtMillis > 0 &&
               data.encryptedNote is string && data.encryptedNote.size() <= 1024 &&
               data.isAcknowledged is bool &&
               data.acknowledgedByUid is string && data.acknowledgedByUid.size() <= 128 &&
               data.acknowledgedAtMillis is int && data.acknowledgedAtMillis >= -1 &&
               data.createdAt is timestamp && data.createdAt <= request.time &&
               data.updatedAt is timestamp && data.updatedAt <= request.time;
      }

      match /partial_payments/{paymentId} {
        allow get: if isVerifiedSignedIn() && isValidId(remoteId) && isValidId(paymentId) && request.auth.uid in existing().participantUids;
        allow list: if isVerifiedSignedIn() && request.auth.uid in existing().participantUids;

        allow create: if isVerifiedSignedIn() &&
                         isValidId(remoteId) &&
                         isValidId(paymentId) &&
                         incoming().paymentId == paymentId &&
                         incoming().remoteId == remoteId &&
                         incoming().recordedByUid == request.auth.uid &&
                         request.auth.uid in incoming().participantUids &&
                         incoming().keys().hasOnly([
                           'paymentId', 'remoteId', 'recordedByUid', 'recordedByName',
                           'participantUids', 'amount', 'paymentMode', 'paidAtMillis',
                           'encryptedNote', 'isAcknowledged', 'acknowledgedByUid',
                           'acknowledgedAtMillis', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidPartialPayment(incoming());

        allow update: if isVerifiedSignedIn() &&
                         isValidId(remoteId) &&
                         isValidId(paymentId) &&
                         isValidPartialPayment(incoming()) &&
                         request.auth.uid in existing().participantUids &&
                         incoming().paymentId == existing().paymentId &&
                         incoming().remoteId == existing().remoteId &&
                         incoming().recordedByUid == existing().recordedByUid &&
                         incoming().amount == existing().amount &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'isAcknowledged', 'acknowledgedByUid', 'acknowledgedAtMillis', 'participantUids', 'updatedAt'
                         ]);

        allow delete: if isVerifiedSignedIn() && isValidId(remoteId) && isValidId(paymentId) && existing().recordedByUid == request.auth.uid;
      }

      // -----------------------------------------------------------------------
      // /shared_records/{remoteId}/audit_trail/{eventId} — Append-Only Immutable
      // -----------------------------------------------------------------------
      function isValidAuditEvent(data) {
        return data.eventId is string && data.eventId.size() >= 1 && data.eventId.size() <= 128 &&
               data.remoteId is string && data.remoteId == remoteId &&
               data.eventType is string && data.eventType in [
                 'CREATED', 'SHARED', 'VIEWED', 'CONFIRMED', 'DISPUTED',
                 'EDITED', 'PAYMENT_RECORDED', 'PAYMENT_ACKNOWLEDGED',
                 'EXTENSION_REQUESTED', 'EXTENSION_ACCEPTED', 'EXTENSION_DECLINED',
                 'SETTLED', 'CANCELLED'
               ] &&
               data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 &&
               data.actorName is string && data.actorName.size() <= 100 &&
               isValidParticipantsList(data.participantUids) &&
               data.actorUid in data.participantUids &&
               data.summaryText is string && data.summaryText.size() <= 500 &&
               data.contentHashSnapshot is string && data.contentHashSnapshot.size() <= 128 &&
               data.acknowledged is bool &&
               data.eventTimeMillis is int && data.eventTimeMillis > 0 &&
               data.createdAt is timestamp && data.createdAt <= request.time;
      }

      match /audit_trail/{eventId} {
        allow get: if isVerifiedSignedIn() && isValidId(remoteId) && isValidId(eventId) && request.auth.uid in existing().participantUids;
        allow list: if isVerifiedSignedIn() && request.auth.uid in existing().participantUids;

        allow create: if isVerifiedSignedIn() &&
                         isValidId(remoteId) &&
                         isValidId(eventId) &&
                         incoming().eventId == eventId &&
                         incoming().remoteId == remoteId &&
                         incoming().actorUid == request.auth.uid &&
                         request.auth.uid in incoming().participantUids &&
                         incoming().keys().hasOnly([
                           'eventId', 'remoteId', 'eventType', 'actorUid', 'actorName',
                           'participantUids', 'summaryText', 'contentHashSnapshot',
                           'acknowledged', 'eventTimeMillis', 'createdAt'
                         ]) &&
                         isValidAuditEvent(incoming());

        allow update: if false; // Append-only audit log

        allow delete: if isVerifiedSignedIn() && isValidId(remoteId) && isValidId(eventId) && existing().actorUid == request.auth.uid;
      }
    }

    // -------------------------------------------------------------------------
    // 3. /chat_threads/{threadId} — In-App Communication Thread
    //    Readable & writable ONLY by the two verified participants on the thread.
    //    Blocked users (thread-level or user-level) cannot create messages.
    // -------------------------------------------------------------------------
    function isValidChatThread(data) {
      return data.threadId is string && data.threadId.size() >= 1 && data.threadId.size() <= 128 &&
             data.threadScope is string && data.threadScope in ['TRANSACTION', 'PARTY'] &&
             optStr(data, 'remoteRecordId', 128) &&
             optStr(data, 'partyName', 100) &&
             data.creatorUid is string && data.creatorUid.size() >= 1 && data.creatorUid.size() <= 128 &&
             optStr(data, 'counterpartyUid', 128) &&
             isValidParticipantsList(data.participantUids) &&
             data.creatorUid in data.participantUids &&
             optStr(data, 'typingUid', 128) &&
             optInt(data, 'typingUpdatedAtMillis', -1, 9999999999999) &&
             isValidOptionalUidList(data.mutedByUids) &&
             optStr(data, 'blockedByUid', 128) &&
             (!('blockedByUids' in data) || isValidOptionalUidList(data.blockedByUids)) &&
             optStr(data, 'reportedByUid', 128) &&
             optStr(data, 'reportReason', 300) &&
             optStr(data, 'lastMessagePreview', 300) &&
             optInt(data, 'lastMessageAtMillis', -1, 9999999999999) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /chat_threads/{threadId} {
      allow get: if isVerifiedSignedIn() && isValidId(threadId) && (resource == null || request.auth.uid in existing().participantUids);
      allow list: if isVerifiedSignedIn() && request.auth.uid in existing().participantUids;

      allow create: if isVerifiedSignedIn() &&
                       isValidId(threadId) &&
                       incoming().threadId == threadId &&
                       incoming().creatorUid == request.auth.uid &&
                       request.auth.uid in incoming().participantUids &&
                       (
                         (!threadId.matches('^dm_.*')) ||
                         (
                           incoming().threadScope == 'PARTY' &&
                           incoming().participantUids.size() == 2 &&
                           incoming().counterpartyUid.size() >= 1 &&
                           incoming().counterpartyUid in incoming().participantUids &&
                           (threadId == 'dm_' + incoming().participantUids[0] + '_' + incoming().participantUids[1] ||
                            threadId == 'dm_' + incoming().participantUids[1] + '_' + incoming().participantUids[0])
                         )
                       ) &&
                       (
                         (!threadId.matches('^tx_.*')) ||
                         (
                           incoming().threadScope == 'TRANSACTION' &&
                           incoming().remoteRecordId.size() >= 1
                         )
                       ) &&
                       incoming().keys().hasOnly([
                         'threadId', 'threadScope', 'remoteRecordId', 'partyName',
                         'creatorUid', 'counterpartyUid', 'participantUids',
                         'typingUid', 'typingUpdatedAtMillis', 'mutedByUids',
                         'blockedByUid', 'blockedByUids', 'reportedByUid', 'reportReason',
                         'lastMessagePreview', 'lastMessageAtMillis',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidChatThread(incoming());

      allow update: if isVerifiedSignedIn() &&
                       isValidId(threadId) &&
                       isValidChatThread(incoming()) &&
                       incoming().threadId == existing().threadId &&
                       incoming().creatorUid == existing().creatorUid &&
                       incoming().threadScope == existing().threadScope &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: Counterparty joins an unclaimed thread
                         (
                           existing().counterpartyUid == '' &&
                           existing().participantUids.size() == 1 &&
                           request.auth.uid != existing().creatorUid &&
                           incoming().counterpartyUid == request.auth.uid &&
                           incoming().participantUids.size() == 2 &&
                           request.auth.uid in incoming().participantUids &&
                           existing().creatorUid in incoming().participantUids &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'counterpartyUid', 'participantUids', 'partyName', 'typingUid',
                             'typingUpdatedAtMillis', 'mutedByUids', 'blockedByUid', 'blockedByUids',
                             'reportedByUid', 'reportReason', 'lastMessagePreview',
                             'lastMessageAtMillis', 'updatedAt'
                           ])
                         ) ||
                         // Action 2: Existing participant updates typing indicator, mute/block/report, or last message
                         (
                           request.auth.uid in existing().participantUids &&
                           incoming().counterpartyUid == existing().counterpartyUid &&
                           incoming().participantUids == existing().participantUids &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'partyName', 'typingUid', 'typingUpdatedAtMillis',
                             'mutedByUids', 'blockedByUid', 'blockedByUids', 'reportedByUid',
                             'reportReason', 'lastMessagePreview',
                             'lastMessageAtMillis', 'updatedAt'
                           ])
                         ) ||
                         // Action 3: Thread creator links counterparty UID onto an unclaimed 1-participant thread
                         (
                           existing().creatorUid == request.auth.uid &&
                           existing().counterpartyUid == '' &&
                           existing().participantUids.size() == 1 &&
                           incoming().counterpartyUid is string &&
                           incoming().counterpartyUid.size() >= 1 &&
                           incoming().counterpartyUid != existing().creatorUid &&
                           incoming().participantUids.size() == 2 &&
                           existing().creatorUid in incoming().participantUids &&
                           incoming().counterpartyUid in incoming().participantUids &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'counterpartyUid', 'participantUids', 'partyName', 'typingUid',
                             'typingUpdatedAtMillis', 'mutedByUids', 'blockedByUid', 'blockedByUids',
                             'reportedByUid', 'reportReason', 'lastMessagePreview',
                             'lastMessageAtMillis', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if isVerifiedSignedIn() && isValidId(threadId) && existing().creatorUid == request.auth.uid;

      // -----------------------------------------------------------------------
      // /chat_threads/{threadId}/messages/{messageId}
      // -----------------------------------------------------------------------
      function isValidChatMessage(data) {
        return data.messageId is string && data.messageId.size() >= 1 && data.messageId.size() <= 128 &&
               data.threadId is string && data.threadId == threadId &&
               data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
               optStr(data, 'senderName', 100) &&
               isValidParticipantsList(data.participantUids) &&
               data.senderUid in data.participantUids &&
               data.messageType is string && data.messageType in [
                 'TEXT', 'QUICK_REPLY', 'PAYMENT_PROOF', 'SYSTEM_AUDIT', 'EXTENSION_REQUEST'
               ] &&
               optStr(data, 'bodyText', 1000) &&
               optStr(data, 'attachmentUri', 512) &&
               optStr(data, 'attachmentMimeType', 100) &&
               optStr(data, 'attachmentName', 150) &&
               data.deliveryStatus is string && data.deliveryStatus in ['SENT', 'DELIVERED', 'READ'] &&
               optInt(data, 'proposedDueDateMillis', -1, 9999999999999) &&
               data.extensionStatus is string && data.extensionStatus in ['NONE', 'PENDING', 'ACCEPTED', 'DECLINED'] &&
               optInt(data, 'sentAtMillis', 0, 9999999999999) &&
               optInt(data, 'deliveredAtMillis', -1, 9999999999999) &&
               optInt(data, 'readAtMillis', -1, 9999999999999) &&
               data.createdAt is timestamp && data.createdAt <= request.time &&
               data.updatedAt is timestamp && data.updatedAt <= request.time;
      }

      function parentThreadAllowsMessage() {
        let threadPath = /databases/$(database)/documents/chat_threads/$(threadId);
        return exists(threadPath)
          && request.auth.uid in get(threadPath).data.participantUids
          && (!('blockedByUid' in get(threadPath).data) || get(threadPath).data.blockedByUid == '')
          && (!('blockedByUids' in get(threadPath).data) || get(threadPath).data.blockedByUids.size() == 0)
          && !isUserBlockedBy(get(threadPath).data.creatorUid, request.auth.uid)
          && (
            !('counterpartyUid' in get(threadPath).data)
            || get(threadPath).data.counterpartyUid == ''
            || !isUserBlockedBy(get(threadPath).data.counterpartyUid, request.auth.uid)
          );
      }

      match /messages/{messageId} {
        allow get: if isVerifiedSignedIn() && isValidId(threadId) && isValidId(messageId) && request.auth.uid in existing().participantUids;
        allow list: if isVerifiedSignedIn() && request.auth.uid in existing().participantUids;

        allow create: if isVerifiedSignedIn() &&
                         isValidId(threadId) &&
                         isValidId(messageId) &&
                         incoming().messageId == messageId &&
                         incoming().threadId == threadId &&
                         incoming().senderUid == request.auth.uid &&
                         request.auth.uid in incoming().participantUids &&
                         parentThreadAllowsMessage() &&
                         incoming().keys().hasOnly([
                           'messageId', 'threadId', 'senderUid', 'senderName',
                           'participantUids', 'messageType', 'bodyText',
                           'attachmentUri', 'attachmentMimeType', 'attachmentName',
                           'deliveryStatus', 'proposedDueDateMillis', 'extensionStatus',
                           'sentAtMillis', 'deliveredAtMillis', 'readAtMillis',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidChatMessage(incoming());

        allow update: if isVerifiedSignedIn() &&
                         isValidId(threadId) &&
                         isValidId(messageId) &&
                         isValidChatMessage(incoming()) &&
                         request.auth.uid in existing().participantUids &&
                         incoming().messageId == existing().messageId &&
                         incoming().threadId == existing().threadId &&
                         incoming().senderUid == existing().senderUid &&
                         incoming().messageType == existing().messageType &&
                         incoming().bodyText == existing().bodyText &&
                         incoming().proposedDueDateMillis == existing().proposedDueDateMillis &&
                         incoming().sentAtMillis == existing().sentAtMillis &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'deliveryStatus', 'deliveredAtMillis', 'readAtMillis',
                           'extensionStatus', 'participantUids', 'updatedAt'
                         ]);

        allow delete: if isVerifiedSignedIn() && isValidId(threadId) && isValidId(messageId) && existing().senderUid == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
